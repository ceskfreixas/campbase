msgid ""
"Primera versió del Campbase, el teu campament base per organitzar projectes."
msgstr ""

#: campbase/releases.py:15
msgid "Taulers i targetes"
msgstr ""

#: campbase/releases.py:16
msgid ""
"Organitza els projectes amb columnes, targetes, etiquetes i dates límit. "
"Escriu descripcions amb format i imatges, participa en els comentaris i "
"esborra els teus quan calgui."
msgstr ""

#: campbase/releases.py:17
msgid "Col·laboració als taulers"
msgstr ""

#: campbase/releases.py:18
msgid ""
"Comparteix taulers i gestiona els permisos. Identifica els participants amb "
"la seva imatge, assigna targetes i cita membres amb @, amb suggeriments i "
"mencions ressaltades."
msgstr ""

#: campbase/releases.py:19
msgid "Notificacions a mà"
msgstr ""

#: campbase/releases.py:20
msgid ""
"Consulta comentaris, mencions, assignacions i comparticions, també de les "
"teves accions. Obre el lloc relacionat amb cada avís i esborra'ls "
"individualment o tots de cop."
msgstr ""

#: campbase/releases.py:21
msgid "Dates i identitat"
msgstr ""

#: campbase/releases.py:22
msgid ""
"Tria l'hora límit en hora local. Identifica els autors dels comentaris amb "
"nom, icona, data i hora, i consulta el nom d'usuari del compte a "
"Preferències."
msgstr ""

#: campbase/releases.py:23
msgid "Sincronització amb Nextcloud Deck"
msgstr ""

#: campbase/releases.py:24
msgid ""
"Connecta el compte des de Comptes en línia de GNOME. Conserva els canvis "
"sense connexió i sincronitza'ls de manera automàtica o manual. Les lectures "
"són més àgils i els avisos s'actualitzen sense interrompre la sincronització "
"de les targetes. Els moviments d'arxivades poden continuar després d'una "
"interrupció de la connexió."
msgstr ""

#: campbase/releases.py:25
msgid "Un espai al teu gust"
msgstr ""

#: campbase/releases.py:26
msgid ""
"Personalitza els projectes i canvia el nom o el color de cada columna per "
"separat. A la secció d'arxivades, restaura o esborra cada targeta des dels "
"seus controls, o esborra-les en grup. Mostra-les i amaga-les sense tornar a "
"l'inici del tauler. Esborra els taulers propis des de la barra lateral. Tria "
"l'aparença, les columnes per fila, el tauler d'inici i la barra lateral."
msgstr ""

#: campbase/releases.py:27
msgid "Arxivades i filtres"
msgstr ""

#: campbase/releases.py:28
msgid ""
"Mostra o amaga les arxivades a totes les columnes i ajusta-les després per "
"separat. Arrossega-les entre columnes, restaura-les deixant-les a la zona "
"normal i desfés els canvis recents. El filtre «Assignades a mi» és al costat "
"de les accions del tauler. Les actualitzacions mantenen la posició de "
"lectura."
msgstr ""

#: campbase/releases.py:29
msgid "Controls de targeta"
msgstr ""

#: campbase/releases.py:30
msgid ""
"Arxiva i arrossega les targetes amb els controls de la dreta, en aquest "
"ordre. Els avatars dels assignats cedeixen el lloc als controls amb una "
"transició suau, també a les arxivades. Els títols aprofiten millor "
"l'amplada. L'avatar al peu de l'editor identifica l'autor o el responsable. "
"Un marcador mostra on deixar anar cada targeta."
msgstr ""

#: campbase/releases.py:31
msgid "Interfície més clara"
msgstr ""

#: campbase/releases.py:32
msgid ""
"Menús amb separadors i dreceres visibles, modals ajustats al contingut i una "
"icona d'enllaç més clara. Marges coherents en compartir taulers, tant durant "
"la càrrega com amb els membres i els resultats de cerca. Papereres de "
"targetes i taulers en vermell i un botó per cancel·lar l'esborrament d'un "
"tauler. Capçaleres de columna sense tooltips d'autoria. Preferències separa "
"el tema de la vista del tauler. En arrossegar cap a les arxivades, es mostra "
"només el marcador necessari."
msgstr ""

#: campbase/releases.py:33
msgid "Sis idiomes, integrats a GNOME"
msgstr ""

#: campbase/releases.py:34
msgid ""
"Interfície amb GTK4 i Adwaita, dreceres de teclat i canvi immediat entre "
"català, euskera, gallec AGAL, castellà, occità aranès i anglès."
msgstr ""

