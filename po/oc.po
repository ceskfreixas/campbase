msgid "{name} t'ha enviat un missatge."
msgstr "{name} t'a enviat un messatge."

msgid "{name} ha reaccionat {emoji} al teu comentari de la targeta «{title}»."
msgstr "{name} a reaccionat {emoji} ath tòn comentari dera carta «{title}»."

msgid "{name} t'ha mencionat en un comentari de la targeta «{title}»."
msgstr "{name} t'a mencionat en un comentari dera carta «{title}»."

msgid "{name} t'ha assignat la targeta «{title}»."
msgstr "{name} t'a assignat era carta «{title}»."

msgid "{name} ha compartit el tauler «{title}» amb tu."
msgstr "{name} a compartit eth taulèr «{title}» damb tu."

msgid "La targeta «{title}» del tauler «{board}» ha arribat al venciment."
msgstr "Era carta «{title}» deth taulèr «{board}» a arribat ath venciment."

msgid "Els avisos segueixen les preferències de notificacions de Deck i Talk a Nextcloud."
msgstr "Es avisi seguissen es preferéncies de notificacions de Deck e Talk en Nextcloud."

msgid "Mencions, reaccions als teus comentaris, assignacions, venciments, taulers compartits amb tu i missatges de Talk."
msgstr "Mencions, reaccions as tòns comentaris, assignacions, venciments, taulèrs compartits damb tu e messatges de Talk."

msgid "Notificacions centrades en els avisos que et demanen atenció, amb un redactat coherent. Les accions pròpies i els canvis rutinaris del tauler ja no omplen la bústia."
msgstr "Notificacions centrades en es avisi que demanen era tua atencion, damb un tèxte coerent. Es accions pròpries e es cambiaments abituaus deth taulèr ja non aumplissen era boèta."

msgid "S'estan carregant les converses…"
msgstr "S'estan cargant es convèrses…"

msgid "Converses mostra un indicador de càrrega mentre espera la resposta. Notificacions presenta només els avisos rellevants, amb textos unificats i sense la frase explicativa del peu."
msgstr "Convèrses mòstre un indicador de carga mentre demore era responsa. Notificacions presente sonque es avisi pertinents, damb tèxtes unificadi e sense era frasa explicativa deth pè."

msgid "Rep mencions, reaccions als teus comentaris, assignacions, venciments, taulers compartits amb tu i missatges de Talk. Obre directament el lloc relacionat amb cada avís. Les accions pròpies i els canvis rutinaris del tauler no omplen la bústia."
msgstr "Recep mencions, reaccions as tòns comentaris, assignacions, venciments, taulèrs compartits damb tu e messatges de Talk. Daurís dirèctament eth lòc restacat damb cada avís. Es accions pròpries e es cambiaments abituaus deth taulèr non aumplissen era boèta."

msgid "Novetats del Campbase {version}."
msgstr "Novetats deth Campbase {version}."

msgid "Quant a, coherent amb GNOME"
msgstr "A prepaus, coerent damb GNOME"

msgid "El diàleg Quant a utilitza el component estàndard d'Adwaita: icona, nom del Campbase, desenvolupador i versió, amb les mides i els marges de GNOME. Els crèdits, el copyright i la llicència ocupen els seus apartats. Es conserven les novetats, el codi font, els enllaços de suport i la informació de Nextcloud Deck."
msgstr "Eth dialòg A prepaus utilize eth compausant estandard d'Adwaita: icòna, nòm deth Campbase, desvolopaire e version, damb es mesures e es marges de GNOME. Es crèdits, eth copyright e era licéncia aucupen es sòns apartats. Se consèrven es novetats, eth còdi hònt, es ligams de supòrt e era informacion de Nextcloud Deck."

msgid "Actualitza els adjunts"
msgstr "Actualiza es fichèrs adjunts"

msgid "Adjunts"
msgstr "Fichèrs adjunts"

msgid "Afegeix un fitxer"
msgstr "Hig un fichèr"

msgid "Aquest servidor no permet modificar aquest missatge."
msgstr "Aguest servidor non permet modificar aguest messatge."

msgid "Comprova els adjunts abans de repetir l'enviament per evitar duplicats."
msgstr "Verifica es fichèrs adjunts abans de repetir er enviament entà evitar duplicats."

msgid "Deck no ha confirmat el canvi d'etiqueta. Torna a carregar-les."
msgstr "Deck non a confirmat eth cambi d'etiqueta. Torna-les a cargar."

msgid "Deck no ha confirmat la restauració del tauler."
msgstr "Deck non a confirmat era restauracion deth taulèr."

msgid "Desa l'adjunt"
msgstr "Desa eth fichèr adjunt"

msgid "Edita el missatge"
msgstr "Edita eth messatge"

msgid "Edita l'etiqueta"
msgstr "Edita era etiqueta"

msgid "El fitxer supera el límit de 64 MiB."
msgstr "Eth fichèr supère eth limit de 64 MiB."

msgid "El missatge ha canviat a Talk. El teu text es conserva; revisa'l abans de desar."
msgstr "Eth messatge a cambiat en Talk. Eth tòn tèxte se consèrve; revisa-lo abans de desar."

msgid "El missatge ja no és a la conversa. Actualitza-la."
msgstr "Eth messatge ja non ei ena convèrsa. Actualiza-la."

msgid "El missatge s'esborrarà de la conversa per a tots els participants."
msgstr "Eth messatge s'escafarà dera convèrsa entà toti es participants."

msgid "Encara no hi ha adjunts."
msgstr "Encara non i a fichèrs adjunts."

msgid "Esborra el missatge"
msgstr "Escafa eth messatge"

msgid "Esborra l'etiqueta"
msgstr "Escafa era etiqueta"

msgid "Gestiona les etiquetes"
msgstr "Gestione es etiquetes"

msgid "Ha passat el termini per modificar aquest missatge."
msgstr "A passat eth termini entà modificar aguest messatge."

msgid "Ja ho he comprovat"
msgstr "Ja ac è verificat"

msgid "L'etiqueta ha canviat a Deck. Revisa-la abans de desar."
msgstr "Era etiqueta a cambiat en Deck. Revisa-la abans de desar."

msgid "L'etiqueta ja no és al tauler. Torna a carregar-les."
msgstr "Era etiqueta ja non ei en taulèr. Torna-les a cargar."

msgid "L'etiqueta «{title}» es retirarà de totes les targetes del tauler."
msgstr "Era etiqueta «{title}» se retirarà de totes es cartes deth taulèr."

msgid "La resposta de Nextcloud és massa gran."
msgstr "Era responsa de Nextcloud ei massa grana."

msgid "No hi ha taulers per recuperar."
msgstr "Non i a taulèrs entà recuperar."

msgid "No s'ha pogut confirmar l'adjunt. Revisa'l abans de repetir l'enviament."
msgstr "Non s'a pogut confirmar eth fichèr adjunt. Revisa-lo abans de repetir er enviament."

msgid "No s'ha pogut descarregar l'adjunt."
msgstr "Non s'a pogut descargar eth fichèr adjunt."

msgid "No s'ha pogut restaurar el tauler"
msgstr "Non s'a pogut restaurar eth taulèr"

msgid "No s'han pogut llegir els adjunts."
msgstr "Non s'an pogut liéger es fichèrs adjunts."

msgid "No tens permís per gestionar les etiquetes del tauler."
msgstr "Non as permís entà gestionar es etiquetes deth taulèr."

msgid "No tens permís per modificar aquesta targeta."
msgstr "Non as permís entà modificar aguesta carta."

msgid "Només pots modificar els teus missatges."
msgstr "Sonque pòs modificar es tòns messatges."

msgid "Pots recuperar els taulers mentre Nextcloud encara els conservi."
msgstr "Pòs recuperar es taulèrs mentre Nextcloud encara les consèrve."

msgid "Restaura el tauler"
msgstr "Restaure eth taulèr"

msgid "Revisa el text del missatge."
msgstr "Revisa eth tèxte deth messatge."

msgid "Revisa l'adjunt pendent"
msgstr "Revisa eth fichèr adjunt pendent"

msgid "S'estan carregant els adjunts…"
msgstr "S'estan cargant es fichèrs adjunts…"

msgid "S'estan carregant les etiquetes…"
msgstr "S'estan cargant es etiquetes…"

msgid "S'està descarregant l'adjunt…"
msgstr "S'està descargant eth fichèr adjunt…"

msgid "S'està enviant l'adjunt…"
msgstr "S'està enviant eth fichèr adjunt…"

msgid "Sincronitza els canvis pendents del tauler abans de gestionar les etiquetes."
msgstr "Sincroniza es cambiaments pendenti deth taulèr abans de gestionar es etiquetes."

msgid "Talk no ha confirmat el canvi. Actualitza la conversa abans de repetir-lo."
msgstr "Talk non a confirmat eth cambi. Actualiza era convèrsa abans de repetir-lo."

msgid "Tauler esborrat"
msgstr "Taulèr escafat"

msgid "Taulers esborrats recentment"
msgstr "Taulèrs escafadi recentament"

msgid "Adjunts a les targetes"
msgstr "Fichèrs adjunts as cartes"

msgid "Recuperació de taulers"
msgstr "Recuperacion de taulèrs"

msgid "Gestió d'etiquetes"
msgstr "Gestion d'etiquetes"

msgid "Missatges de Talk"
msgstr "Messatges de Talk"

msgid "Sincronització més lleugera"
msgstr "Sincronizacion mès leugèra"

msgid "Afegeix i desa documents des de la targeta amb els selectors natius de GNOME. Els enviaments sense confirmar es revisen abans de repetir-los."
msgstr "Hig e desa documents dera carta damb es selectors natius de GNOME. Es enviaments sense confirmar se revisen abans de repetir-les."

msgid "Desfés l'esborrament d'un tauler o recupera'l des del menú de taulers esborrats recentment, mentre Nextcloud el conservi. També es recuperen la icona i els colors locals."
msgstr "Deshè er escafament d'un taulèr o recupèra-lo deth menú de taulèrs escafadi recentament, mentre Nextcloud lo consèrve. Tanben se recupèren era icòna e es colors locaus."

msgid "Canvia el nom i el color de les etiquetes, o esborra-les amb confirmació. Els canvis s'apliquen a les targetes del tauler i respecten els permisos i els canvis pendents."
msgstr "Cambia eth nòm e eth color des etiquetes, o escafa-les damb confirmacion. Es cambiaments s'apliquen as cartes deth taulèr e respècten es permisi e es cambiaments pendenti."

msgid "Edita i esborra els teus missatges quan el servidor ho permet, amb comprovació dels canvis recents i confirmació abans d'esborrar. Els esborranys d'edició es mantenen si hi ha un error."
msgstr "Edita e escafa es tòns messatges quan eth servidor ac permet, damb verificacion des cambiaments recents e confirmacion abans d'escafar. Es brolhons d'edicion se mantenen se i a un error."

msgid "Es reutilitzen les dades quan Nextcloud confirma que no han canviat. La memòria cau és limitada, es renova després d'escriure i no substitueix les comprovacions dels canvis al servidor."
msgstr "Se reutilizen es donades quan Nextcloud confirme que non an cambiat. Era memòria temporau ei limitada, se renauís dempús d'escríuer e non substituís es verificacions des cambiaments en servidor."

msgid "Identificador de l'aplicació"
msgstr "Identificador dera aplicacion"

msgid "El Campbase utilitza l'identificador cat.ceskfreixas.Campbase, vinculat al domini ceskfreixas.cat, per preparar la distribució pública."
msgstr "Eth Campbase utilize er identificador cat.ceskfreixas.Campbase, restacat ath domeni ceskfreixas.cat, entà preparar era distribucion publica."

msgid "Estabilitat dels diàlegs"
msgstr "Estabilitat des dialògs"

msgid "S'ha millorat el tancament dels diàlegs d'etiquetes i d'esborrament de taulers, i la compatibilitat del disseny adaptable amb versions anteriors d'Adwaita."
msgstr "S'a melhorat eth barrament des dialògs d'etiquetes e d'esborrament de taulèrs, e era compatibilitat deth dessenh adaptable damb versions anteriores d'Adwaita."

msgid "Fitxa de l'aplicació"
msgstr "Ficha dera aplicacion"

msgid "La presentació del Campbase s'ha actualitzat amb descripcions i captures en sis idiomes."
msgstr "Era presentacion deth Campbase s'a actualizat damb descripcions e captures en sies idiòmes."

msgid "Comentaris sense contingut"
msgstr "Comentaris sense contengut"

msgid "L'estat sense comentaris és més compacte, sense la icona gran i amb el text alineat com el dels adjunts."
msgstr "Er estat sense comentaris ei mès compacte, sense era icòna grana e damb eth tèxte alinhat coma enes adjunti."

msgid "Estats buits i desplegables"
msgstr "Estats vuets e desplegables"

msgid "Els comentaris i els taulers esborrats mostren estats buits més compactes, i el desplegable de mencions s'adapta als resultats."
msgstr "Es comentaris e es taulèrs esborrats mòstren estats vuets mès compactes, e eth desplegable de mencions s'adapte as resultats."

msgid "Arxiva-les totes"
msgstr "Archiva-les totes"

msgid "Arxiva"
msgstr "Archiva"

msgid "S'arxivarà {count} targeta de «{column}», encara que hi hagi filtres actius."
msgid_plural "S'arxivaran {count} targetes de «{column}», encara que hi hagi filtres actius."
msgstr[0] "S’archivarà {count} tarja de «{column}», encara que i age filtres actius."
msgstr[1] "S’archivaràn {count} targes de «{column}», encara que i age filtres actius."

msgid "Taulers esborrats"
msgstr "Taulèrs suprimidi"

msgid "Arxivament en bloc"
msgstr "Archivament en blòc"

msgid "Arxiva totes les targetes d'una columna des del seu menú, amb confirmació i sincronització conjunta."
msgstr "Archiva totes es targes d’ua colomna des deth sòn menú, damb confirmacion e sincronizacion conjunta."

msgid "Interfície més compacta"
msgstr "Interfàcia mès compacta"

msgid "Unifiquem el marge interior de les targetes i escurcem les etiquetes dels menús."
msgstr "Unificam eth marge interior des targes e acorçam es etiquetes des menús."

msgid "Paperera"
msgstr "Paperèra"

msgid "Opcions del tauler"
msgstr "Opcions deth taulèr"

msgid "Deck no ha pogut carregar la paperera."
msgstr "Deck non a pogut cargar era paperèra."

msgid "No es poden restaurar targetes en aquest tauler."
msgstr "Non se pòden restaurar targes en aguest taulèr."

msgid "La targeta ha canviat. Actualitza la paperera."
msgstr "Era tarja a cambiat. Actualiza era paperèra."

msgid "La columna original ja no està disponible."
msgstr "Era colomna originau ja non ei disponibla."

msgid "Deck no ha confirmat la restauració de la targeta."
msgstr "Deck non a confirmat era restauracion dera tarja."

msgid "Resol els canvis pendents d'aquesta targeta abans de restaurar-la."
msgstr "Resòlv es cambis pendents d’aguesta tarja abans de restaurar-la."

msgid "Pots restaurar les targetes mentre Nextcloud encara les conservi."
msgstr "Pòs restaurar es targes mentre Nextcloud encara les consèrve."

msgid "Columna no disponible"
msgstr "Colomna non disponibla"

msgid "La paperera és buida."
msgstr "Era paperèra ei ueda."

msgid "S'està restaurant…"
msgstr "Se restaure…"

msgid "Paperera del tauler"
msgstr "Paperèra deth taulèr"

msgid "Recupera les targetes esborrades des de la paperera de cada tauler, amb la columna original i la data d’eliminació."
msgstr "Recupèra es targes suprimides dera paperèra de cada taulèr, damb era colomna originau e era data de supression."

msgid "Restaura"
msgstr "Restaura"

msgid "S'està carregant…"
msgstr "Se cargue…"

msgid "Targetes esborrades"
msgstr "Targes suprimides"

msgid "No hi ha targetes esborrades."
msgstr "Non i a targes suprimides."

msgid "Elements esborrats"
msgstr "Elements suprimidi"

msgid "Esborra el tauler…"
msgstr "Suprimís eth taulèr…"

msgid "Columnes"
msgstr "Colomnes"

msgid "No es poden restaurar columnes en aquest tauler."
msgstr "Non se pòden restaurar colomnes en aguest taulèr."

msgid "Deck no ha confirmat la restauració de la columna."
msgstr "Deck non a confirmat era restauracion dera colomna."

msgid "Resol els canvis pendents d'aquesta columna abans de restaurar-la."
msgstr "Resòlv es cambis pendents d’aguesta colomna abans de restaurar-la."

msgid "Pots restaurar targetes i columnes mentre Nextcloud encara les conservi."
msgstr "Pòs restaurar targes e colomnes mentre Nextcloud encara les consèrve."

msgid "No hi ha elements esborrats."
msgstr "Non i a elements suprimidi."

msgid "Recupera targetes i columnes des dels elements esborrats de cada tauler."
msgstr "Recupèra targes e colomnes des elements suprimidi de cada taulèr."
