msgstr "Còpia ua imatge compatibla de mens de 16 MB e torna a provar."

msgid "El porta-retalls no conté cap imatge compatible."
msgstr "Eth porta-retalhs non conten cap d'imatge compatibla."

msgid "La imatge local ha canviat. Torna-la a seleccionar."
msgstr "Era imatge locau a cambiat. Torna-la a trigar."

msgid "La imatge no és al servidor de Nextcloud del compte."
msgstr "Era imatge non ei en servidor de Nextcloud deth compde."

msgid "No s'ha pogut carregar la imatge de Nextcloud."
msgstr "Non s'a pogut cargar era imatge de Nextcloud."

msgid "Nextcloud no ha retornat una imatge compatible."
msgstr "Nextcloud non a retornat ua imatge compatibla."

msgid "Deck no ha confirmat l'adjunt de la imatge."
msgstr "Deck non a confirmat er adjunt dera imatge."

msgid "No s'ha trobat una imatge pendent d'enviar. L'esborrany es conserva."
msgstr "Non s'a trobat ua imatge pendenta d'enviar. Eth borrolhon se consèrve."

msgid " · No s'ha pogut carregar"
msgstr " · Non s'a pogut cargar"

