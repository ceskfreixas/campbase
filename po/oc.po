msgstr "Non s'a pogut connectar. Revisa eth compde de Nextcloud en Compdes en linha de GNOME."

msgid "No s'ha pogut obrir el compte de GNOME. Revisa els Comptes en línia."
msgstr "Non s'a pogut daurir eth compde de GNOME. Revisa Compdes en linha."

msgid "El compte de GNOME ha canviat. Torna a seleccionar-lo a les preferències."
msgstr "Eth compde de GNOME a cambiat. Torna-lo a trigar en Preferéncies."

msgid "El compte no s'ha pogut autenticar. Revisa'l a Comptes en línia de GNOME."
msgstr "Non s'a pogut autenticar eth compde. Revisa-lo en Compdes en linha de GNOME."

msgid "Connecta el compte de Nextcloud per sincronitzar."
msgstr "Connecta eth compde de Nextcloud entà sincronizar."

msgid "Connecta el compte de Nextcloud."
msgstr "Connecta eth compde de Nextcloud."

msgid "No s'ha pogut contactar amb Nextcloud. Els canvis pendents es conserven en aquest ordinador."
msgstr "Non s'a pogut contactar damb Nextcloud. Es cambis pendenti se consèrven en aguest dispositiu."

msgid "No s'ha pogut completar la sincronització. Els canvis locals es conserven."
msgstr "Non s'a pogut completar era sincronizacion. Es cambis locaus se consèrven."

msgid "No s'ha pogut sincronitzar"
msgstr "Non s'a pogut sincronizar"

