msgstr[0] "Iruzkin {count}"
msgstr[1] "{count} iruzkin"

msgid "Reacciona al comentari"
msgstr "Erreakzionatu iruzkinari"

msgid "M'agrada"
msgstr "Atsegin dut"

msgid "M'encanta"
msgstr "Izugarri gustatzen zait"

msgid "Em fa riure"
msgstr "Barregarria da"

msgid "Celebrem-ho"
msgstr "Ospatu dezagun"

msgid "Ho estic mirant"
msgstr "Begiratzen ari naiz"

msgid "Gràcies"
msgstr "Eskerrik asko"

msgid "No s'ha pogut confirmar la reacció"
msgstr "Ezin izan da erreakzioa baieztatu"

msgid " Revisa els comentaris abans de tornar-ho a provar."
msgstr " Begiratu iruzkinak berriro saiatu aurretik."

msgid "Nextcloud no ha confirmat la resposta al comentari."
msgstr "Nextcloud-ek ez du iruzkinaren erantzuna baieztatu."

msgid "{name} ha reaccionat {emoji} a un comentari de «{title}»."
