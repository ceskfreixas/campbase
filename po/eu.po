msgid "L'etiqueta ha canviat a Deck. Revisa-la abans de desar."
msgstr "Etiketa aldatu egin da Deck-en. Berrikusi gorde aurretik."

msgid "L'etiqueta ja no és al tauler. Torna a carregar-les."
msgstr "Etiketa jada ez dago taulan. Kargatu berriz etiketak."

msgid "L'etiqueta «{title}» es retirarà de totes les targetes del tauler."
msgstr "«{title}» etiketa taulako txartel guztietatik kenduko da."

msgid "La resposta de Nextcloud és massa gran."
msgstr "Nextcloud-en erantzuna handiegia da."

msgid "No hi ha taulers per recuperar."
msgstr "Ez dago berreskuratzeko taularik."

msgid "No s'ha pogut confirmar l'adjunt. Revisa'l abans de repetir l'enviament."
msgstr "Ezin izan da eranskina berretsi. Egiaztatu berriz bidali aurretik."

msgid "No s'ha pogut descarregar l'adjunt."
msgstr "Ezin izan da eranskina deskargatu."

msgid "No s'ha pogut restaurar el tauler"
msgstr "Ezin izan da taula berreskuratu"

msgid "No s'han pogut llegir els adjunts."
