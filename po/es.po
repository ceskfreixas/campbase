msgid "Una aplicació lliure de taulers kanban, especialment dissenyada per a GNOME amb GTK4 i Adwaita. Organitza els projectes amb targetes i sincronitza'ls amb Nextcloud Deck."
msgstr "Una aplicación libre de tableros kanban, especialmente diseñada para GNOME con GTK4 y Adwaita. Organiza los proyectos con tarjetas y sincronízalos con Nextcloud Deck."

msgid "Aquest compte ja no és als Comptes en línia de GNOME."
msgstr "Esta cuenta ya no está en Cuentas en línea de GNOME."

msgid "Cal revisar l'accés a Nextcloud a Configuració → Comptes en línia."
msgstr "Revisa el acceso a Nextcloud en Configuración → Cuentas en línea."

msgid "GNOME no ha proporcionat les credencials del compte."
msgstr "GNOME no ha proporcionado las credenciales de la cuenta."

msgid "Introdueix una adreça de Nextcloud vàlida."
msgstr "Introduce una dirección de Nextcloud válida."

msgid "L'adreça de Nextcloud ha de començar per https://."
msgstr "La dirección de Nextcloud debe empezar por https://."

msgid "No s'ha pogut accedir als Comptes en línia de GNOME."
msgstr "No se ha podido acceder a Cuentas en línea de GNOME."

msgid "Selecciona el compte de Nextcloud que vols utilitzar."
msgstr "Selecciona la cuenta de Nextcloud que quieres utilizar."

msgid "Selecciona un compte de Nextcloud dels Comptes en línia de GNOME."
msgstr "Selecciona una cuenta de Nextcloud de Cuentas en línea de GNOME."

msgid "Selecciona un compte de Nextcloud a Comptes en línia de GNOME."
msgstr "Selecciona una cuenta de Nextcloud en Cuentas en línea de GNOME."

msgid "Cal resoldre els canvis pendents abans de canviar de compte."
msgstr "Resuelve los cambios pendientes antes de cambiar de cuenta."

msgid "No s'ha pogut connectar. Revisa el compte de Nextcloud a Comptes en línia de GNOME."
msgstr "No se ha podido conectar. Revisa la cuenta de Nextcloud en Cuentas en línea de GNOME."

msgid "No s'ha pogut obrir el compte de GNOME. Revisa els Comptes en línia."
msgstr "No se ha podido abrir la cuenta de GNOME. Revisa Cuentas en línea."

msgid "El compte de GNOME ha canviat. Torna a seleccionar-lo a les preferències."
msgstr "La cuenta de GNOME ha cambiado. Vuelve a seleccionarla en Preferencias."

msgid "El compte no s'ha pogut autenticar. Revisa'l a Comptes en línia de GNOME."
msgstr "No se ha podido autenticar la cuenta. Revísala en Cuentas en línea de GNOME."

msgid "Connecta el compte de Nextcloud per sincronitzar."
msgstr "Conecta la cuenta de Nextcloud para sincronizar."

msgid "Connecta el compte de Nextcloud."
msgstr "Conecta la cuenta de Nextcloud."

msgid "No s'ha pogut contactar amb Nextcloud. Els canvis pendents es conserven en aquest ordinador."
msgstr "No se ha podido contactar con Nextcloud. Los cambios pendientes se conservan en este dispositivo."

msgid "No s'ha pogut completar la sincronització. Els canvis locals es conserven."
msgstr "No se ha podido completar la sincronización. Los cambios locales se conservan."

msgid "No s'ha pogut sincronitzar"
msgstr "No se ha podido sincronizar"

msgid "No s'ha pogut completar l'operació."
msgstr "No se ha podido completar la operación."

msgid "No s'ha pogut completar el canvi"
msgstr "No se ha podido completar el cambio"

msgid "Nextcloud no permet aquesta operació amb el compte actual."
msgstr "Nextcloud no permite esta operación con la cuenta actual."

msgid "Nextcloud no ha pogut completar l'operació."
msgstr "Nextcloud no ha podido completar la operación."

msgid "Nextcloud no ha retornat una llista de taulers vàlida."
msgstr "Nextcloud no ha devuelto una lista de tableros válida."

msgid "La resposta de Nextcloud no té el format esperat."
msgstr "La respuesta de Nextcloud no tiene el formato esperado."

msgid "No s'han pogut llegir les columnes del tauler."
msgstr "No se han podido leer las columnas del tablero."

msgid "No s'han pogut llegir els comentaris de Deck."
msgstr "No se han podido leer los comentarios de Deck."

msgid "La targeta o el tauler ja no són a Deck. Torna a sincronitzar."
msgstr "La tarjeta o el tablero ya no están en Deck. Vuelve a sincronizar."

msgid "La targeta ha canviat a Deck. Revisa les dues versions."
msgstr "La tarjeta ha cambiado en Deck. Revisa ambas versiones."

msgid "El contingut d'aquesta targeta ha canviat a Deck. El teu esborrany s'ha conservat."
msgstr "El contenido de esta tarjeta ha cambiado en Deck. Tu borrador se ha conservado."

msgid "La targeta s'ha mogut a una altra columna des d'un altre dispositiu."
msgstr "La tarjeta se ha movido a otra columna desde otro dispositivo."

msgid "Deck no ha confirmat el canvi de columna. El moviment queda pendent."
msgstr "Deck no ha confirmado el cambio de columna. El movimiento queda pendiente."

msgid "La targeta no és a la columna esperada a Deck."
msgstr "La tarjeta no está en la columna esperada en Deck."

msgid "No s'ha pogut verificar la targeta a Deck."
msgstr "No se ha podido verificar la tarjeta en Deck."

msgid "Deck no ha confirmat tots els canvis. L'esborrany es conserva."
msgstr "Deck no ha confirmado todos los cambios. El borrador se conserva."

msgid "El nom del projecte ha canviat a Deck. El teu canvi es conserva."
msgstr "El nombre del proyecto ha cambiado en Deck. Tu cambio se conserva."

msgid "Deck no ha confirmat el nom del projecte."
msgstr "Deck no ha confirmado el nombre del proyecto."

msgid "No es pot confirmar la creació. Revisa Deck abans de tornar a enviar aquesta targeta."
msgstr "No se puede confirmar la creación. Revisa Deck antes de volver a enviar esta tarjeta."

msgid "No es pot confirmar si Deck ha creat la targeta. Obre Deck i comprova-ho abans de tornar-la a enviar."
msgstr "No se puede confirmar si Deck ha creado la tarjeta. Abre Deck y compruébalo antes de volver a enviarla."

msgid "L'enviament es va interrompre. Revisa Deck abans de tornar a crear aquesta targeta."
msgstr "El envío se interrumpió. Revisa Deck antes de volver a crear esta tarjeta."

msgid "Primer cal enviar la targeta nova a Deck."
msgstr "Primero hay que enviar la nueva tarjeta a Deck."

msgid "Afegeix una columna al tauler abans de crear la primera targeta."
msgstr "Añade una columna al tablero antes de crear la primera tarjeta."

msgid "No s'ha pogut confirmar el comentari"
msgstr "No se ha podido confirmar el comentario"

msgid " Revisa Deck abans de tornar-lo a enviar."
msgstr " Revisa Deck antes de volver a enviarlo."

msgid "Aquest fitxer no és una imatge vàlida."
msgstr "Este archivo no es una imagen válida."

msgid "La imatge és massa gran. El límit és de 16 MB."
msgstr "La imagen es demasiado grande. El límite es de 16 MB."

msgid "La imatge és massa gran. Tria'n una de mida més petita."
msgstr "La imagen es demasiado grande. Elige una más pequeña."

msgid "Tria una imatge PNG, JPEG, WebP o GIF de mida adequada."
msgstr "Elige una imagen PNG, JPEG, WebP o GIF de tamaño adecuado."

msgid "Tria una imatge o una icona SVG vàlida."
msgstr "Elige una imagen o un icono SVG válidos."

msgid "No s'ha pogut llegir la imatge."
msgstr "No se ha podido leer la imagen."

msgid "No s'ha pogut afegir la imatge"
msgstr "No se ha podido añadir la imagen"

msgid "No s'ha pogut enganxar la imatge"
msgstr "No se ha podido pegar la imagen"

msgid "Copia una imatge compatible de menys de 16 MB i torna-ho a provar."
msgstr "Copia una imagen compatible de menos de 16 MB y vuelve a intentarlo."

msgid "El porta-retalls no conté cap imatge compatible."
msgstr "El portapapeles no contiene ninguna imagen compatible."

msgid "La imatge local ha canviat. Torna-la a seleccionar."
msgstr "La imagen local ha cambiado. Vuelve a seleccionarla."

msgid "La imatge no és al servidor de Nextcloud del compte."
msgstr "La imagen no está en el servidor de Nextcloud de la cuenta."

msgid "No s'ha pogut carregar la imatge de Nextcloud."
msgstr "No se ha podido cargar la imagen de Nextcloud."

msgid "Nextcloud no ha retornat una imatge compatible."
msgstr "Nextcloud no ha devuelto una imagen compatible."

msgid "Deck no ha confirmat l'adjunt de la imatge."
msgstr "Deck no ha confirmado el adjunto de la imagen."

msgid "No s'ha trobat una imatge pendent d'enviar. L'esborrany es conserva."
msgstr "No se ha encontrado una imagen pendiente de enviar. El borrador se conserva."

msgid " · No s'ha pogut carregar"
msgstr " · No se ha podido cargar"

