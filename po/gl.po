msgid "Una aplicació lliure de taulers kanban, especialment dissenyada per a GNOME amb GTK4 i Adwaita. Organitza els projectes amb targetes i sincronitza'ls amb Nextcloud Deck."
msgstr "Uma aplicação livre de tabuleiros kanban, especialmente concebida para o GNOME com GTK4 e Adwaita. Organiza os projetos com cartões e sincroniza-os com o Nextcloud Deck."

msgid "Aquest compte ja no és als Comptes en línia de GNOME."
msgstr "Esta conta já não está nas Contas em linha do GNOME."

msgid "Cal revisar l'accés a Nextcloud a Configuració → Comptes en línia."
msgstr "Revê o acesso ao Nextcloud em Configuração → Contas em linha."

msgid "GNOME no ha proporcionat les credencials del compte."
msgstr "O GNOME não forneceu as credenciais da conta."

msgid "Introdueix una adreça de Nextcloud vàlida."
msgstr "Introduz um endereço válido do Nextcloud."

msgid "L'adreça de Nextcloud ha de començar per https://."
msgstr "O endereço do Nextcloud deve começar por https://."

msgid "No s'ha pogut accedir als Comptes en línia de GNOME."
msgstr "Não foi possível aceder às Contas em linha do GNOME."

msgid "Selecciona el compte de Nextcloud que vols utilitzar."
msgstr "Seleciona a conta do Nextcloud que queres utilizar."

msgid "Selecciona un compte de Nextcloud dels Comptes en línia de GNOME."
msgstr "Seleciona uma conta do Nextcloud das Contas em linha do GNOME."

msgid "Selecciona un compte de Nextcloud a Comptes en línia de GNOME."
msgstr "Seleciona uma conta do Nextcloud nas Contas em linha do GNOME."

msgid "Cal resoldre els canvis pendents abans de canviar de compte."
msgstr "Resolve as mudanças pendentes antes de mudar de conta."

msgid "No s'ha pogut connectar. Revisa el compte de Nextcloud a Comptes en línia de GNOME."
msgstr "Não foi possível ligar. Revê a conta do Nextcloud nas Contas em linha do GNOME."

msgid "No s'ha pogut obrir el compte de GNOME. Revisa els Comptes en línia."
msgstr "Não foi possível abrir a conta do GNOME. Revê as Contas em linha."

msgid "El compte de GNOME ha canviat. Torna a seleccionar-lo a les preferències."
msgstr "A conta do GNOME mudou. Volta a selecioná-la nas Preferências."

msgid "El compte no s'ha pogut autenticar. Revisa'l a Comptes en línia de GNOME."
msgstr "Não foi possível autenticar a conta. Revê-a nas Contas em linha do GNOME."

msgid "Connecta el compte de Nextcloud per sincronitzar."
msgstr "Liga a conta do Nextcloud para sincronizar."

msgid "Connecta el compte de Nextcloud."
msgstr "Liga a conta do Nextcloud."

msgid "No s'ha pogut contactar amb Nextcloud. Els canvis pendents es conserven en aquest ordinador."
msgstr "Não foi possível contactar com o Nextcloud. As mudanças pendentes conservam-se neste dispositivo."

msgid "No s'ha pogut completar la sincronització. Els canvis locals es conserven."
msgstr "Não foi possível completar a sincronização. As mudanças locais conservam-se."

msgid "No s'ha pogut sincronitzar"
msgstr "Não foi possível sincronizar"

msgid "No s'ha pogut completar l'operació."
msgstr "Não foi possível completar a operação."

msgid "No s'ha pogut completar el canvi"
msgstr "Não foi possível completar a mudança"

msgid "Nextcloud no permet aquesta operació amb el compte actual."
msgstr "O Nextcloud não permite esta operação com a conta atual."

msgid "Nextcloud no ha pogut completar l'operació."
msgstr "O Nextcloud não pôde completar a operação."

msgid "Nextcloud no ha retornat una llista de taulers vàlida."
msgstr "O Nextcloud não devolveu uma lista válida de tabuleiros."

msgid "La resposta de Nextcloud no té el format esperat."
msgstr "A resposta do Nextcloud não tem o formato esperado."

msgid "No s'han pogut llegir les columnes del tauler."
msgstr "Não foi possível ler as colunas do tabuleiro."

msgid "No s'han pogut llegir els comentaris de Deck."
msgstr "Não foi possível ler os comentários do Deck."

msgid "La targeta o el tauler ja no són a Deck. Torna a sincronitzar."
msgstr "O cartão ou o tabuleiro já não estão no Deck. Volta a sincronizar."

msgid "La targeta ha canviat a Deck. Revisa les dues versions."
msgstr "O cartão mudou no Deck. Revê ambas as versões."

msgid "El contingut d'aquesta targeta ha canviat a Deck. El teu esborrany s'ha conservat."
msgstr "O conteúdo deste cartão mudou no Deck. O teu rascunho foi conservado."

msgid "La targeta s'ha mogut a una altra columna des d'un altre dispositiu."
msgstr "O cartão foi movido para outra coluna a partir doutro dispositivo."

msgid "Deck no ha confirmat el canvi de columna. El moviment queda pendent."
msgstr "O Deck não confirmou a mudança de coluna. O movimento fica pendente."

msgid "La targeta no és a la columna esperada a Deck."
msgstr "O cartão não está na coluna esperada no Deck."

msgid "No s'ha pogut verificar la targeta a Deck."
msgstr "Não foi possível verificar o cartão no Deck."

msgid "Deck no ha confirmat tots els canvis. L'esborrany es conserva."
msgstr "O Deck não confirmou todas as mudanças. O rascunho conserva-se."

msgid "El nom del projecte ha canviat a Deck. El teu canvi es conserva."
msgstr "O nome do projeto mudou no Deck. A tua mudança conserva-se."

msgid "Deck no ha confirmat el nom del projecte."
msgstr "O Deck não confirmou o nome do projeto."

msgid "No es pot confirmar la creació. Revisa Deck abans de tornar a enviar aquesta targeta."
msgstr "Não é possível confirmar a criação. Revê o Deck antes de voltar a enviar este cartão."

msgid "No es pot confirmar si Deck ha creat la targeta. Obre Deck i comprova-ho abans de tornar-la a enviar."
msgstr "Não é possível confirmar se o Deck criou o cartão. Abre o Deck e comprova-o antes de voltar a enviá-lo."

msgid "L'enviament es va interrompre. Revisa Deck abans de tornar a crear aquesta targeta."
msgstr "O envio interrompeu-se. Revê o Deck antes de voltar a criar este cartão."

msgid "Primer cal enviar la targeta nova a Deck."
msgstr "Primeiro é preciso enviar o novo cartão ao Deck."

msgid "Afegeix una columna al tauler abans de crear la primera targeta."
msgstr "Adiciona uma coluna ao tabuleiro antes de criar o primeiro cartão."

msgid "No s'ha pogut confirmar el comentari"
msgstr "Não foi possível confirmar o comentário"

msgid " Revisa Deck abans de tornar-lo a enviar."
msgstr " Revê o Deck antes de voltar a enviá-lo."

msgid "Aquest fitxer no és una imatge vàlida."
msgstr "Este ficheiro não é uma imagem válida."

msgid "La imatge és massa gran. El límit és de 16 MB."
msgstr "A imagem é demasiado grande. O limite é de 16 MB."

msgid "La imatge és massa gran. Tria'n una de mida més petita."
msgstr "A imagem é demasiado grande. Escolhe uma mais pequena."

msgid "Tria una imatge PNG, JPEG, WebP o GIF de mida adequada."
msgstr "Escolhe uma imagem PNG, JPEG, WebP ou GIF dum tamanho adequado."

msgid "Tria una imatge o una icona SVG vàlida."
msgstr "Escolhe uma imagem ou um ícone SVG válidos."

msgid "No s'ha pogut llegir la imatge."
msgstr "Não foi possível ler a imagem."

msgid "No s'ha pogut afegir la imatge"
msgstr "Não foi possível adicionar a imagem"

msgid "No s'ha pogut enganxar la imatge"
msgstr "Não foi possível colar a imagem"

msgid "Copia una imatge compatible de menys de 16 MB i torna-ho a provar."
msgstr "Copia uma imagem compatível de menos de 16 MB e tenta de novo."

msgid "El porta-retalls no conté cap imatge compatible."
msgstr "A área de transferência não contém nenhuma imagem compatível."

msgid "La imatge local ha canviat. Torna-la a seleccionar."
msgstr "A imagem local mudou. Volta a selecioná-la."

msgid "La imatge no és al servidor de Nextcloud del compte."
msgstr "A imagem não está no servidor do Nextcloud da conta."

msgid "No s'ha pogut carregar la imatge de Nextcloud."
msgstr "Não foi possível carregar a imagem do Nextcloud."

msgid "Nextcloud no ha retornat una imatge compatible."
msgstr "O Nextcloud não devolveu uma imagem compatível."

msgid "Deck no ha confirmat l'adjunt de la imatge."
msgstr "O Deck não confirmou o anexo da imagem."

msgid "No s'ha trobat una imatge pendent d'enviar. L'esborrany es conserva."
msgstr "Não se encontrou uma imagem pendente de enviar. O rascunho conserva-se."

msgid " · No s'ha pogut carregar"
msgstr " · Não foi possível carregar"

